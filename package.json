{
  "name": "laravel-routes-explorer",
  "displayName": "Laravel Routes Explorer",
  "description": "Laravel プロジェクトのルート一覧をサイドバーに表示します",
  "version": "0.1.0",
  "publisher": "sugumura",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sugumura/laravel-routes-explorer.git"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=24"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "laravel",
    "php",
    "routes"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "laravelRoutes",
          "title": "Laravel Routes",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "laravelRoutes": [
        {
          "id": "laravelRoutes.routes",
          "name": "Routes"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "laravelRoutes.routes",
        "contents": "Laravel プロジェクトが見つかりません。\nワークスペース内に artisan ファイルがあるフォルダがあるか確認してください。サブフォルダにある場合は設定 laravelRoutes.projectRoot で指定できます。\n[設定を開く](command:workbench.action.openSettings?%5B%22laravelRoutes%22%5D)",
        "when": "!laravelRoutes.hasProject"
      },
      {
        "view": "laravelRoutes.routes",
        "contents": "route:list の実行に失敗しました。\n[出力パネルを開く](command:laravelRoutes.showOutput)\n[再読み込み](command:laravelRoutes.refresh)",
        "when": "laravelRoutes.hasProject && laravelRoutes.loadError"
      }
    ],
    "commands": [
      {
        "command": "laravelRoutes.refresh",
        "title": "Laravel Routes: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "laravelRoutes.showOutput",
        "title": "Laravel Routes: Show Output"
      },
      {
        "command": "laravelRoutes.filter",
        "title": "Laravel Routes: Filter by Middleware",
        "icon": "$(filter)"
      },
      {
        "command": "laravelRoutes.clearFilter",
        "title": "Laravel Routes: Clear Filter",
        "icon": "$(clear-all)"
      },
      {
        "command": "laravelRoutes.openSource",
        "title": "Go to Source"
      },
      {
        "command": "laravelRoutes.openDefinition",
        "title": "Go to Route Definition"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "laravelRoutes.clearFilter",
          "when": "view == laravelRoutes.routes && laravelRoutes.filterActive",
          "group": "navigation@1"
        },
        {
          "command": "laravelRoutes.filter",
          "when": "view == laravelRoutes.routes",
          "group": "navigation@2"
        },
        {
          "command": "laravelRoutes.refresh",
          "when": "view == laravelRoutes.routes",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "laravelRoutes.filter",
          "when": "laravelRoutes.hasProject"
        },
        {
          "command": "laravelRoutes.clearFilter",
          "when": "laravelRoutes.filterActive"
        },
        {
          "command": "laravelRoutes.openSource",
          "when": "false"
        },
        {
          "command": "laravelRoutes.openDefinition",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "laravelRoutes.openSource",
          "when": "view == laravelRoutes.routes && viewItem == route",
          "group": "navigation@1"
        },
        {
          "command": "laravelRoutes.openDefinition",
          "when": "view == laravelRoutes.routes && viewItem == route",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Laravel Routes Explorer",
      "properties": {
        "laravelRoutes.command": {
          "type": "string",
          "default": "php artisan route:list --json",
          "scope": "resource",
          "markdownDescription": "ルート一覧を取得するコマンド。プロジェクトルートを cwd としてシェル経由で実行します。`${projectRoot}` と `${workspaceFolder}` を使えます。\n\n例:\n- Sail: `vendor/bin/sail artisan route:list --json`\n- Docker Compose: `docker compose exec -T app php artisan route:list --json`"
        },
        "laravelRoutes.projectRoot": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Laravel プロジェクト（`artisan` があるフォルダ）のパス。ワークスペースフォルダからの相対パスまたは絶対パス。空なら自動検出します。"
        },
        "laravelRoutes.exceptVendor": {
          "type": "boolean",
          "default": false,
          "description": "vendor パッケージが定義したルートを除外します（route:list --except-vendor）。",
          "scope": "resource"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.5.0"
  },
  "packageManager": "pnpm@10.33.0"
}
